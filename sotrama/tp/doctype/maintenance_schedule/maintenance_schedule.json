{
 "doctype": "DocType",
 "name": "Maintenance Schedule",
 "module": "TP",
 "fields": [
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_schedule",
   "label": "Maintenance Plan"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_plan",
   "label": "Schedule Configuration"
  },
  {
   "label": "Vehicle",
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "options": "Vehicle",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Company",
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "read_only": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Schedule Type",
   "fieldname": "schedule_type",
   "fieldtype": "Select",
   "options": "\nCalendar\nMileage",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Job Type",
   "fieldname": "job_type",
   "fieldtype": "Link",
   "options": "Maintenance Job Type",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_intervals"
  },
  {
   "label": "Interval Months",
   "fieldname": "interval_months",
   "fieldtype": "Int",
   "depends_on": "eval:doc.schedule_type == 'Calendar'",
   "mandatory_depends_on": "eval:doc.schedule_type == 'Calendar'",
   "min_value": 1
  },
  {
   "label": "Interval KM",
   "fieldname": "interval_km",
   "fieldtype": "Float",
   "depends_on": "eval:doc.schedule_type == 'Mileage'",
   "mandatory_depends_on": "eval:doc.schedule_type == 'Mileage'",
   "min_value": 1
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_last_service",
   "label": "Last and Next Service",
   "collapsible": 1
  },
  {
   "label": "Last Service Date",
   "fieldname": "last_service_date",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "label": "Last Service Odometer",
   "fieldname": "last_service_odometer",
   "fieldtype": "Float"
  },
  {
   "label": "Last Service Job Card",
   "fieldname": "last_service_job_card",
   "fieldtype": "Link",
   "options": "Maintenance Job Card",
   "read_only": 1,
   "description": "Last submitted job card applied to this maintenance plan."
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_next_service"
  },
  {
   "label": "Next Due Date",
   "fieldname": "next_due_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Next Due Odometer",
   "fieldname": "next_due_odometer",
   "fieldtype": "Float",
   "in_list_view": 1
  },
  {
   "label": "Status",
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nActive\nPaused\nCompleted",
   "default": "Active",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only": 1
  },
  {
   "label": "Next Schedule",
   "fieldname": "next_schedule",
   "fieldtype": "Link",
   "options": "Maintenance Schedule",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "description": "Next recurring schedule generated when this plan is completed."
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_notes",
   "label": "Notes",
   "collapsible": 1
  },
  {
   "label": "Notes",
   "fieldname": "notes",
   "fieldtype": "Text Editor"
  }
 ],
 "links": [],
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "naming_rule": "Expression",
 "naming_expression": "SCH-.YYYY.-.####",
 "autoname": "format",
 "permissions": [
  {
   "role": "System Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Fleet Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Workshop",
   "permlevel": 0,
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "print": 1,
   "email": 0,
   "export": 0,
   "report": 0,
   "share": 0
  }
 ],
 "icon": "calendar-clock",
 "description": "Maintenance Schedule records for Sotrama public-works fleet operations."
}

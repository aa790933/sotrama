{
 "doctype": "DocType",
 "name": "Inspection Item",
 "module": "TP",
 "fields": [
  {
   "fieldtype": "Section Break",
   "fieldname": "section_checklist_item",
   "label": "Inspection Checklist Item",
   "collapsible": 1
  },
  {
   "label": "Category",
   "fieldname": "category",
   "fieldtype": "Data",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "label": "Item Details",
   "fieldname": "item_details",
   "fieldtype": "Text",
   "reqd": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_checklist_status"
  },
  {
   "label": "Status",
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nNot Checked\nOkay\nDefective",
   "default": "Not Checked",
   "in_list_view": 1,
   "reqd": 1,
   "description": "Keep Not Checked until the inspector has physically verified this item. Every item must be marked Okay or Defective before submission."
  },
  {
   "label": "Safety Critical",
   "fieldname": "is_safety_critical",
   "fieldtype": "Check",
   "permlevel": 1,
   "default": "0",
   "description": "When enabled, a defective result automatically marks the vehicle Out of Service."
  },
  {
   "label": "Remarks",
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "depends_on": "eval:doc.status == 'Defective'"
  },
  {
   "label": "Photo Proof",
   "fieldname": "photo_proof",
   "fieldtype": "Attach Image"
  },
  {
   "label": "Linked Issue",
   "fieldname": "linked_issue",
   "fieldtype": "Link",
   "options": "Issue",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "istable": 1,
 "links": [],
 "icon": "clipboard-list",
 "description": "Inspection Item records for Sotrama public-works fleet operations."
}

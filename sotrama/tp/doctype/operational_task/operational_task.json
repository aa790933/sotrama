{
 "doctype": "DocType",
 "name": "Operational Task",
 "module": "TP",
 "fields": [
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_task_assignment",
   "label": "Task Assignment"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_assignment",
   "label": "Assignment Details"
  },
  {
   "label": "Task Date",
   "fieldname": "task_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "label": "Vehicle",
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "options": "Vehicle",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Task Type",
   "fieldname": "task_type",
   "fieldtype": "Select",
   "options": "\nRoad Paving\nBridge Construction\nEarthmoving\nTransport\nGrading\nDrainage\nSignaling\nSurvey",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Transport Activity",
   "fieldname": "transport_kind",
   "fieldtype": "Select",
   "options": "\nCollective Passenger Transport\nSchool Transport\nGoods Transport\nDangerous Goods Transport\nTaxi Transport",
   "depends_on": "eval:doc.task_type == 'Transport'",
   "mandatory_depends_on": "eval:doc.task_type == 'Transport'"
  },
  {
   "label": "Transport Basis",
   "fieldname": "transport_basis",
   "fieldtype": "Select",
   "options": "\nFor-Hire Transport\nOwn-Account Transport",
   "depends_on": "eval:doc.task_type == 'Transport'",
   "mandatory_depends_on": "eval:doc.task_type == 'Transport'",
   "description": "Specify whether this transport is performed for a third party or for the Company's own account."
  },
  {
   "label": "Regulatory Applicability",
   "fieldname": "transport_regulatory_status",
   "fieldtype": "Select",
   "options": "\nTo Be Confirmed\nRegulated\nOfficially Confirmed Not Subject",
   "default": "To Be Confirmed",
   "depends_on": "eval:doc.task_type == 'Transport'",
   "mandatory_depends_on": "eval:doc.task_type == 'Transport'",
   "description": "Do not assume own-account hauling is exempt or regulated. Confirm applicability with the competent authority before submission."
  },
  {
   "label": "Authority Decision Reference",
   "fieldname": "transport_authority_reference",
   "fieldtype": "Data",
   "depends_on": "eval:doc.task_type == 'Transport' && (doc.transport_basis == 'Own-Account Transport' || doc.transport_regulatory_status == 'Officially Confirmed Not Subject')"
  },
  {
   "label": "Authority Decision Date",
   "fieldname": "transport_authority_decision_date",
   "fieldtype": "Date",
   "depends_on": "eval:doc.task_type == 'Transport' && (doc.transport_basis == 'Own-Account Transport' || doc.transport_regulatory_status == 'Officially Confirmed Not Subject')"
  },
  {
   "label": "Authority Decision Evidence",
   "fieldname": "transport_authority_evidence",
   "fieldtype": "Attach",
   "depends_on": "eval:doc.task_type == 'Transport' && (doc.transport_basis == 'Own-Account Transport' || doc.transport_regulatory_status == 'Officially Confirmed Not Subject')"
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_task_assignment"
  },
  {
   "label": "Project",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Company",
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "read_only": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Driver / Operator",
   "fieldname": "driver",
   "fieldtype": "Link",
   "options": "Driver",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "mandatory_depends_on": "eval:doc.task_type == 'Transport' && doc.transport_regulatory_status == 'Regulated'",
   "description": "Assign a road driver for regulated transport, or an equipment operator when relevant."
  },
  {
   "label": "Supervisor",
   "fieldname": "supervisor",
   "fieldtype": "Link",
   "options": "Employee",
   "in_list_view": 1
  },
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_task_execution",
   "label": "Execution"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_time",
   "label": "Execution Time",
   "collapsible": 1
  },
  {
   "label": "Start Date",
   "fieldname": "start_date",
   "fieldtype": "Datetime"
  },
  {
   "label": "End Date",
   "fieldname": "end_date",
   "fieldtype": "Datetime"
  },
  {
   "label": "Planned Hours",
   "fieldname": "planned_hours",
   "fieldtype": "Float"
  },
  {
   "label": "Actual Hours",
   "fieldname": "actual_hours",
   "fieldtype": "Float",
   "read_only": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_odometer"
  },
  {
   "label": "Start Odometer",
   "fieldname": "start_odometer",
   "fieldtype": "Float"
  },
  {
   "label": "End Odometer",
   "fieldname": "end_odometer",
   "fieldtype": "Float"
  },
  {
   "label": "Distance Covered (km)",
   "fieldname": "distance_covered",
   "fieldtype": "Float",
   "read_only": 1
  },
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_task_output",
   "label": "Output"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_output",
   "label": "Production Output",
   "collapsible": 1
  },
  {
   "label": "Task Description",
   "fieldname": "task_description",
   "fieldtype": "Text Editor"
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_output"
  },
  {
   "label": "Output Quantity",
   "fieldname": "output_quantity",
   "fieldtype": "Float",
   "description": "e.g. m² of asphalt paved, m³ of earth moved"
  },
  {
   "label": "Output Unit",
   "fieldname": "output_unit",
   "fieldtype": "Select",
   "options": "\nm²\nm³\nt\nkm\nHours"
  },
  {
   "label": "Status",
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nPlanned\nIn Progress\nCompleted\nCancelled",
   "default": "Planned",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Notes",
   "fieldname": "notes",
   "fieldtype": "Text Editor"
  }
 ],
 "links": [],
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "naming_rule": "Expression",
 "autoname": "OT-.YYYY.-.####",
 "permissions": [
  {
   "role": "System Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Fleet Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Workshop",
   "permlevel": 0,
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "print": 1,
   "email": 0,
   "export": 0,
   "report": 0,
   "share": 0
  }
 ],
 "icon": "clipboard-check",
 "description": "Operational Task records for Sotrama public-works fleet operations."
}

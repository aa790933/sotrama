{
 "doctype": "DocType",
 "name": "Maintenance Job Card",
 "module": "TP",
 "fields": [
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_work_order",
   "label": "Work Order"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_work_order",
   "label": "Job Details"
  },
  {
   "label": "Job Date",
   "fieldname": "job_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "label": "Vehicle",
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "options": "Vehicle",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Company",
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "read_only": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Job Nature",
   "fieldname": "job_nature",
   "fieldtype": "Select",
   "options": "\nScheduled Service\nRepair\nBreakdown\nAccident\nInspection\nAccidental",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Job Type",
   "fieldname": "job_type",
   "fieldtype": "Link",
   "options": "Maintenance Job Type",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Preventive Maintenance Schedule",
   "fieldname": "maintenance_schedule",
   "fieldtype": "Link",
   "options": "Maintenance Schedule",
   "depends_on": "eval:doc.job_nature == 'Scheduled Service'",
   "description": "Active maintenance plan this scheduled service completes."
  },
  {
   "label": "Status",
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nDraft\nPending\nIn Progress\nOn Hold\nCompleted\nCancelled",
   "default": "Draft",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_issue"
  },
  {
   "label": "Supplier",
   "fieldname": "supplier",
   "fieldtype": "Link",
   "options": "Supplier",
   "in_standard_filter": 1,
   "description": "Workshop or vendor performing the repair"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_diagnosis",
   "label": "Reported Issue & Diagnosis",
   "collapsible": 1
  },
  {
   "label": "Reported Issue",
   "fieldname": "reported_issue",
   "fieldtype": "Text Editor",
   "description": "Customer complaint or observed problem"
  },
  {
   "label": "Diagnosis",
   "fieldname": "diagnosis",
   "fieldtype": "Text Editor",
   "description": "Technician findings and root cause"
  },
  {
   "label": "Work Performed",
   "fieldname": "work_performed",
   "fieldtype": "Text Editor"
  },
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_execution_costs",
   "label": "Execution & Costs"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_execution",
   "label": "Work Execution & Vehicle Readings",
   "collapsible": 1
  },
  {
   "label": "Odometer Before (km)",
   "fieldname": "odometer_before",
   "fieldtype": "Float",
   "description": "Odometer reading when vehicle arrived"
  },
  {
   "label": "Odometer After (km)",
   "fieldname": "odometer_after",
   "fieldtype": "Float",
   "description": "Odometer reading when vehicle left"
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_execution"
  },
  {
   "label": "Completion Date",
   "fieldname": "completion_date",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "label": "Driver at Time of Issue",
   "fieldname": "driver_at_time",
   "fieldtype": "Link",
   "options": "Driver"
  },
  {
   "label": "Linked Breakdown",
   "fieldname": "linked_breakdown",
   "fieldtype": "Link",
   "options": "Breakdown Incident",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "description": "If this job was triggered by a breakdown"
  },
  {
   "label": "Linked Breakdown Incident",
   "fieldname": "linked_breakdown_incident",
   "fieldtype": "Link",
   "options": "Breakdown Incident",
   "read_only": 1,
   "no_copy": 1,
   "description": "Breakdown that triggered this job card"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_cost_summary",
   "label": "Cost Summary & Stock",
   "collapsible": 1
  },
  {
   "label": "Cost Center",
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "options": "Cost Center",
   "in_standard_filter": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_cost_center"
  },
  {
   "label": "Total Parts Cost (DZD)",
   "fieldname": "total_parts_cost",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_cost_summary"
  },
  {
   "label": "Total Labour Cost (DZD)",
   "fieldname": "total_labour_cost",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "label": "Total Other Cost (DZD)",
   "fieldname": "total_other_cost",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "label": "Total Cost (DZD)",
   "fieldname": "total_cost",
   "fieldtype": "Currency",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "label": "Downtime (Hours)",
   "fieldname": "downtime_hours",
   "fieldtype": "Float",
   "read_only": 1,
   "description": "Hours the vehicle was out of service"
  },
  {
   "label": "Stock Entry",
   "fieldname": "stock_entry",
   "fieldtype": "Link",
   "options": "Stock Entry",
   "read_only": 1,
   "description": "Material Issue generated for consumed maintenance parts."
  },
  {
   "label": "Linked Maintenance Schedule",
   "fieldname": "linked_maintenance_schedule",
   "fieldtype": "Link",
   "options": "Maintenance Schedule",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "label": "Previous Schedule Last Service Date",
   "fieldname": "previous_schedule_last_service_date",
   "fieldtype": "Date",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "label": "Previous Schedule Last Service Odometer",
   "fieldname": "previous_schedule_last_service_odometer",
   "fieldtype": "Float",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "label": "Previous Schedule Last Service Job Card",
   "fieldname": "previous_schedule_last_service_job_card",
   "fieldtype": "Link",
   "options": "Maintenance Job Card",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "label": "Previous Schedule Next Due Date",
   "fieldname": "previous_schedule_next_due_date",
   "fieldtype": "Date",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "label": "Previous Schedule Next Due Odometer",
   "fieldname": "previous_schedule_next_due_odometer",
   "fieldtype": "Float",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "label": "Applied Schedule Service Odometer",
   "fieldname": "applied_schedule_last_service_odometer",
   "fieldtype": "Float",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_parts_evidence",
   "label": "Parts & Evidence"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_parts",
   "label": "Parts, Labour & Other Costs",
   "collapsible": 1
  },
  {
   "label": "Spare Parts (Stock Items)",
   "fieldname": "parts_used",
   "fieldtype": "Table",
   "options": "Job Card Part",
   "description": "Add inventory items from ERPNext Item. On submission, the quantities are issued from the vehicle's configured parts warehouse and included in the parts cost."
  },
  {
   "label": "Labour (Employees / Mechanics)",
   "fieldname": "labour_lines",
   "fieldtype": "Table",
   "options": "Job Card Labour",
   "description": "Add mechanics from Frappe HR Employee. Enter hours and hourly rate; each line contributes to the labour cost."
  },
  {
   "label": "Other Costs",
   "fieldname": "other_costs",
   "fieldtype": "Table",
   "options": "Job Card Other Cost",
   "description": "Record additional maintenance expenses such as towing, fuel, rental, tolls or permits."
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_attachments",
   "label": "Attachments & Notes",
   "collapsible": 1
  },
  {
   "label": "Photos",
   "fieldname": "photos",
   "fieldtype": "Table",
   "options": "Job Card Photo"
  },
  {
   "label": "Notes",
   "fieldname": "notes",
   "fieldtype": "Text Editor"
  }
 ],
 "links": [],
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "naming_rule": "Expression",
 "naming_expression": "JC-.YYYY.-.####",
 "autoname": "format",
 "permissions": [
  {
   "role": "System Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Fleet Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Workshop",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 0,
   "amend": 0,
   "print": 1,
   "email": 0,
   "export": 0,
   "report": 0,
   "share": 0
  }
 ],
 "icon": "wrench",
 "description": "Maintenance Job Card records for Sotrama public-works fleet operations."
}

{
 "doctype": "DocType",
 "name": "Driver",
 "module": "TP",
 "fields": [
  {
   "label": "Driver Name",
   "fieldname": "driver_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "label": "Employee",
   "fieldname": "employee",
   "fieldtype": "Link",
   "options": "Employee",
   "description": "Linked ERPNext Employee record"
  },
  {
   "label": "License Number",
   "fieldname": "license_number",
   "fieldtype": "Data",
   "in_list_view": 1,
   "reqd": 1,
   "in_standard_filter": 1,
   "description": "Driver's license number"
  },
  {
   "label": "License Class",
   "fieldname": "license_class",
   "fieldtype": "Select",
   "options": "\nC\nC1\nC2\nC3\nD\nD1\nE",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "License category (C=truck, D=bus, etc.)"
  },
  {
   "label": "License Expiry",
   "fieldname": "license_expiry",
   "fieldtype": "Date",
   "in_list_view": 1,
   "reqd": 1,
   "description": "Date the driver's license expires"
  },
  {
   "label": "License Issue Date",
   "fieldname": "license_issue_date",
   "fieldtype": "Date",
   "description": "Date the license was issued"
  },
  {
   "label": "Medical Certificate Expiry",
   "fieldname": "medical_expiry",
   "fieldtype": "Date",
   "in_list_view": 1,
   "description": "Date the medical certificate expires"
  },
  {
   "label": "Safety Training Expiry",
   "fieldname": "safety_training_expiry",
   "fieldtype": "Date",
   "in_list_view": 1,
   "description": "Date the safety training certification expires"
  },
  {
   "label": "Date of Birth",
   "fieldname": "date_of_birth",
   "fieldtype": "Date"
  },
  {
   "label": "National ID Number",
   "fieldname": "national_id",
   "fieldtype": "Data",
   "description": "Carte d'identité nationale number"
  },
  {
   "label": "Address",
   "fieldname": "address",
   "fieldtype": "Text"
  },
  {
   "label": "Phone",
   "fieldname": "phone",
   "fieldtype": "Data"
  },
  {
   "label": "Email",
   "fieldname": "email",
   "fieldtype": "Data"
  },
  {
   "label": "Hire Date",
   "fieldname": "hire_date",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "label": "Status",
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nActive\nSuspended\nTerminated\nOn Leave",
   "default": "Active",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "label": "Total Incidents",
   "fieldname": "total_incidents",
   "fieldtype": "Int",
   "default": "0",
   "read_only": 1,
   "description": "Count of breakdown incidents attributed to this driver"
  },
  {
   "label": "Notes",
   "fieldname": "notes",
   "fieldtype": "Text Editor"
  }
 ],

{
 "doctype": "DocType",
 "name": "Driver",
 "module": "TP",
 "fields": [
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_identity",
   "label": "Identity & Employment"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_driver_identity",
   "label": "Driver Identity"
  },
  {
   "label": "Driver Name",
   "fieldname": "driver_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "reqd": 1,
   "allow_on_submit": 1
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_employment"
  },
  {
   "label": "Employee",
   "fieldname": "employee",
   "fieldtype": "Link",
   "options": "Employee",
   "in_list_view": 0,
   "in_standard_filter": 1,
   "allow_on_submit": 1,
   "description": "Optional link to the authoritative ERPNext/Frappe HR Employee record. Only HR Manager and System Manager can change this link; fleet roles do not receive broad Employee read access.",
   "permlevel": 3
  },
  {
   "label": "Company",
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Company employing or assigning this driver. Defaults from the linked Employee."
  },
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_licences",
   "label": "Licences & Safety"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_licence",
   "label": "Driving Licence"
  },
  {
   "label": "License Number",
   "fieldname": "license_number",
   "fieldtype": "Data",
   "in_list_view": 0,
   "in_standard_filter": 1,
   "allow_on_submit": 1,
   "permlevel": 1,
   "description": "Driving licence number. HR-only; Fleet Manager sees the licence category and expiry instead."
  },
  {
   "label": "Algerian Licence Category",
   "fieldname": "license_class",
   "fieldtype": "Select",
   "options": "\nA1\nA\nB\nB(E)\nC1\nC1(E)\nC\nC(E)\nD\nD(E)\nF",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "allow_on_submit": 1,
   "permlevel": 2,
   "description": "Categories listed in Article 180 of Executive Decree 04-381 as amended by Executive Decree 25-169 of 22 June 2025. Visible to Fleet Manager and HR."
  },
  {
   "label": "License Expiry",
   "fieldname": "license_expiry",
   "fieldtype": "Date",
   "in_list_view": 1,
   "allow_on_submit": 1,
   "permlevel": 2,
   "description": "Date the driver's licence expires. Visible to Fleet Manager and HR; hidden from Workshop."
  },
  {
   "label": "License Issue Date",
   "fieldname": "license_issue_date",
   "fieldtype": "Date",
   "permlevel": 1,
   "allow_on_submit": 1,
   "description": "Date the licence was issued. HR-only."
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_medical"
  },
  {
   "label": "Medical Certificate Expiry",
   "fieldname": "medical_expiry",
   "fieldtype": "Date",
   "permlevel": 1,
   "allow_on_submit": 1,
   "in_list_view": 0,
   "description": "Date the medical certificate expires"
  },
  {
   "label": "Safety Training Expiry",
   "fieldname": "safety_training_expiry",
   "fieldtype": "Date",
   "permlevel": 1,
   "allow_on_submit": 1,
   "in_list_view": 0,
   "description": "Date the safety training certification expires"
  },
  {
   "label": "Brevet Professionnel Number",
   "fieldname": "professional_certificate_number",
   "fieldtype": "Data",
   "permlevel": 1,
   "allow_on_submit": 1,
   "description": "Professional transport certificate number, where required by the transport activity."
  },
  {
   "label": "Brevet Professionnel",
   "fieldname": "professional_certificate",
   "fieldtype": "Attach",
   "permlevel": 1,
   "allow_on_submit": 1,
   "description": "Scanned professional certificate required for the road-transport activities listed in Articles 79–80 of Law 26-09."
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_restricted_compliance",
   "label": "Restricted Medical & Screening Records",
   "collapsible": 1,
   "permlevel": 1
  },
  {
   "label": "Medical & Screening History",
   "fieldname": "compliance_records",
   "fieldtype": "Table",
   "options": "Driver Compliance Record",
   "permlevel": 1,
   "allow_on_submit": 1,
   "description": "Restricted HR/medical records. Keep the latest medical fitness and drug-screening results and their review/expiry dates."
  },
  {
   "label": "Date of Birth",
   "fieldname": "date_of_birth",
   "fieldtype": "Date",
   "permlevel": 1,
   "allow_on_submit": 1
  },
  {
   "label": "National ID Number",
   "fieldname": "national_id",
   "fieldtype": "Data",
   "permlevel": 1,
   "allow_on_submit": 1,
   "description": "Carte d'identité nationale number"
  },
  {
   "fieldtype": "Tab Break",
   "fieldname": "tab_contact",
   "label": "Contact & Notes"
  },
  {
   "fieldtype": "Section Break",
   "fieldname": "section_contact",
   "label": "Contact Information"
  },
  {
   "label": "Address",
   "fieldname": "address",
   "fieldtype": "Text",
   "allow_on_submit": 1,
   "permlevel": 1,
   "description": "Residential address. HR-only; use the operational phone/email fields for Fleet contact."
  },
  {
   "fieldtype": "Column Break",
   "fieldname": "column_contact"
  },
  {
   "label": "Operational Phone",
   "fieldname": "phone",
   "fieldtype": "Data",
   "allow_on_submit": 1,
   "permlevel": 2,
   "description": "Company-approved operational contact number. Do not copy a private personal number without HR authorization."
  },
  {
   "label": "Operational Email",
   "fieldname": "email",
   "fieldtype": "Data",
   "allow_on_submit": 1,
   "permlevel": 2,
   "description": "Use a company email address for Fleet operations; do not store a personal email address."
  },
  {
   "label": "Hire Date",
   "fieldname": "hire_date",
   "fieldtype": "Date",
   "allow_on_submit": 1,
   "in_list_view": 0,
   "permlevel": 1
  },
  {
   "label": "Status",
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nActive\nSuspended\nTerminated\nOn Leave",
   "default": "Active",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only_depends_on": "eval:doc.docstatus == 1"
  },
  {
   "label": "Total Incidents",
   "fieldname": "total_incidents",
   "fieldtype": "Int",
   "default": "0",
   "read_only": 1,
   "permlevel": 2,
   "description": "Count of breakdown incidents attributed to this driver. Visible to Fleet Manager and HR; hidden from Workshop."
  },
  {
   "label": "Operational Notes",
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "permlevel": 2,
   "description": "Fleet operational notes only. Do not record medical, disciplinary or personal HR information."
  }
 ],
 "links": [],

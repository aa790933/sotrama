{
 "doctype": "DocType",
 "name": "Company Classification",
 "module": "TP",
 "fields": [
  {
   "label": "Grade",
   "fieldname": "grade",
   "fieldtype": "Int",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1,
   "description": "Classification grade I–IX per Arrêté Interministeriel"
  },
  {
   "label": "Category",
   "fieldname": "category",
   "fieldtype": "Select",
   "options": "\nTP (Travaux Publics)\nBTP (Bâtiment et Travaux Publics)\nHydraulique\nForestier",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "label": "Registration Number",
   "fieldname": "registration_number",
   "fieldtype": "Data",
   "in_list_view": 1,
   "description": "Certificate number from MTPIB"
  },
  {
   "label": "Issue Date",
   "fieldname": "issue_date",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "label": "Expiry Date",
   "fieldname": "expiry_date",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "label": "Validity Period",
   "fieldname": "validity_period",
   "fieldtype": "Int",
   "default": "5",
   "description": "Validity period in years (5 years per MTPIB)"
  },
  {
   "label": "Active",
   "fieldname": "active",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "label": "Effectif (EF) Score",
   "fieldname": "effectif_score",
   "fieldtype": "Int",
   "default": "1",
   "description": "Staff size score (1–9)"
  },
  {
   "label": "Effectif Coefficient (CB1)",
   "fieldname": "effectif_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Encadrement (E) Score",
   "fieldname": "encadrement_score",
   "fieldtype": "Int",
   "default": "1",
   "description": "Management staff score (0 or 1)"
  },
  {
   "label": "Encadrement Coefficient (CB2)",
   "fieldname": "encadrement_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Apprentice (RA) Score",
   "fieldname": "apprentice_score",
   "fieldtype": "Int",
   "default": "1"
  },
  {
   "label": "Apprentice Coefficient (CB3)",
   "fieldname": "apprentice_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Training (FR) Score",
   "fieldname": "training_score",
   "fieldtype": "Int",
   "default": "1",
   "description": "Training/perfectionnement/recyclage score (1–9)"
  },
  {
   "label": "Training Coefficient (CB4)",
   "fieldname": "training_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Material Value (VM) Score",
   "fieldname": "material_value_score",
   "fieldtype": "Int",
   "default": "1",
   "description": "Equipment value score (1–9)"
  },
  {
   "label": "Material Value Coefficient (CB5)",
   "fieldname": "material_value_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Capital (CS) Score",
   "fieldname": "capital_score",
   "fieldtype": "Int",
   "default": "1"
  },
  {
   "label": "Capital Coefficient (CB6)",
   "fieldname": "capital_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Revenue (CA) Score",
   "fieldname": "revenue_score",
   "fieldtype": "Int",
   "default": "1",
   "description": "Turnover score over 3 years (1–9)"
  },
  {
   "label": "Revenue Coefficient (CB7)",
   "fieldname": "revenue_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Good Execution (ABE) Score",
   "fieldname": "abe_score",
   "fieldtype": "Float",
   "default": "1.0",
   "description": "Attestations de Bonne Exécution score (1–1.8)"
  },
  {
   "label": "Good Execution Coefficient (CB8)",
   "fieldname": "abe_coefficient",
   "fieldtype": "Float",
   "default": "1.0"
  },
  {
   "label": "Total Score (NT)",
   "fieldname": "total_score",
   "fieldtype": "Float",
   "read_only": 1,
   "in_list_view": 1,
   "description": "NT = [(CB1×EF)×(CB2×E) + CB3×RA + CB4×FR] + CB5×VM + (CB6×CS + CB7×CA) + CB8×ABE"
  }
 ],
 "links": [],
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "naming_rule": "Expression",
 "naming_expression": "CLAS-{grade}-{category}",
 "autoname": "format"
}
